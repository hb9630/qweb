[Unit]
Description=Keeper ccweb（管理终端 + AI 助手，工作目录形态）
After=network-online.target
Wants=network-online.target

[Service]
User=huangbin
Environment=HOME=/home/huangbin
Environment=CCWEB_PORT=18090
Environment=KEEPERD_URL=http://10.10.1.248:7998
WorkingDirectory=/home/huangbin/keeper/deploy/ccweb
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
